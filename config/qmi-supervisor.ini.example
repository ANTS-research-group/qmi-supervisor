# Parser-default reference. Fresh installations use web-first idle objectives.
# See CONFIGURATION.md for every option, constraint and installation default.
[system]
# DEBUG, INFO, WARNING or ERROR; --log-level overrides it for one run.
log_level = INFO
# Optional rotating log file; empty keeps only the systemd journal.
log_file =

[modem]
device = auto
apn = internet
# Empty preserves modem selection; auto or an explicit MCC+MNC (e.g. 99910).
plmn =
mode = connect
# Optional stable selection when more than one modem is attached:
serial =

[network]
# Obtain IPv4 directly from QMI; use dhcp only if your modem requires it.
method = qmi
# Once connectivity is verified, fixed uses this exact numeric metric.
# Legacy INI files without route_policy still retain their fixed metric.
# primary selects below other IPv4 main defaults, using route_metric as a ceiling.
# backup selects above other IPv4 main defaults, using route_metric as a floor.
route_policy = fixed
# Unsigned 32-bit value, 0..4294967295; primary CLI defaults to 100, backup to 700.
route_metric = 700
default_route = true
dns = auto
# Networks always reached through this modem, such as the other UEs of a private
# core: up to 8 comma-separated IPv4 networks, for example 192.168.4.0/24.
routes =
# While checking/down, the owned WWAN default stays behind foreign defaults.
# A successful TCP connection to either target verifies WWAN, bound to its interface/IP.
# Private networks should use a reachable service in their own network instead.
connectivity_check = true
# 1..4 unique numeric IPv4:port endpoints; no DNS names, loopback or multicast.
connectivity_targets = 1.1.1.1:443,8.8.8.8:53
# Seconds: interval 1..60; timeout 0.1..5 and <= interval.
connectivity_interval = 3
connectivity_timeout = 1
# Consecutive rounds (1..10), independent of the 1 Hz telemetry acquisition.
connectivity_failures = 2
connectivity_successes = 2

[recovery]
retry_initial = 2
retry_max = 60
registration_timeout = 180
operation_timeout = 20
poll_interval = 10

[telemetry]
enabled = true
interval = 1
directory = files
csv = true
json = true
# The complete profile requests changing UE metrics in every sample.
# custom refreshes each query group at its own period (seconds; 0 disables).
# Every USB QMI response costs about 32 ms, so fewer requests per sample are faster.
profile = full
query_signal = 1.0
query_cell = 1.0
query_txrx = 1.0
query_serving = 5.0
query_bands = 10.0
query_strength = 0.0
query_home = 3600.0
query_wds_stats = 1.0
query_wds_status = 1.0
query_wds_rates = 10.0
# Modem-pushed WDS statistics/status and NAS serving system: off, shadow or on.
indications = off
collection_budget = 0.8
request_timeout = 1
queue_size = 64
flush_interval = 1.0
gps_max_age = 10.0
throughput = false
gps = false
# gpsd reads an external GPSd service; modem starts the modem's QMI LOC receiver.
gps_source = gpsd
# Optional UDP sinks: disabled until a host is provided.
udp_host =
udp_port = 5006
collector_host =
collector_port = 5007


[web]
enabled = false
host = 127.0.0.1
# host = auto listens on localhost plus a physical management LAN or a bridge
# with physical ports, even when WWAN is the preferred Internet route.
# Prefer a non-cellular LAN default route, then an eligible LAN IPv4 without a gateway.
# Never select WWAN/Docker/veth automatically; without LAN, keep localhost only.
# It follows address changes every web.address_refresh and requires a password.
port = 8080
history_size = 120
# Configure an account with the installer: --web-user admin --set-web-password.
username = admin
# Generated by the installer, never enter the plaintext password here.
password_hash =
session_timeout = 28800
# Concurrent HTTP requests served by the web child.
max_workers = 8
# Seconds between management LAN address rechecks; only with host = auto.
address_refresh = 10.0
# Seconds between status refreshes requested by an open page (1..30).
poll_interval = 2.0
