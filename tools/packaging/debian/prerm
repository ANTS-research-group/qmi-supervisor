#!/bin/sh
# Stop the service before its files are replaced or removed. Enabling state is
# preserved, so a reinstall or upgrade keeps the unit enabled as the admin left
# it; only purge disables it.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        systemctl stop qmi-supervisor.service >/dev/null 2>&1 || true
        ;;
esac

case "$1" in
    remove|deconfigure)
        # Upgrades keep the timer: U3 installs packages from the updater's own unit.
        systemctl stop qmi-supervisor-update-check.timer qmi-supervisor-update-check.service qmi-supervisor-update-check-manual.service >/dev/null 2>&1 || true
        ;;
esac

exit 0
