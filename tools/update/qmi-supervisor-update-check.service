[Unit]
Description=Check for qmi-supervisor updates
Documentation=file:/usr/share/doc/qmi-supervisor/CONFIGURATION.md
# Ordering only: the timer starts this unit long after boot, so nothing is pulled in.
After=network-online.target
# A source uninstall can remove the application while the package's timer stays enabled.
ConditionPathExists=/opt/qmi-supervisor/tools/update/updater.py

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/qmi-supervisor-update check --auto
SyslogIdentifier=qmi-supervisor-update
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
User=root
Group=root
StateDirectory=qmi-supervisor/update
StateDirectoryMode=0755
ProtectSystem=strict
# The single update lock and the request directory live in /run (tmpfs).
ReadWritePaths=/run
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
